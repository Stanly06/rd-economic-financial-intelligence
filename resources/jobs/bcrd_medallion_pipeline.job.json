{
  "name": "rd_economic_medallion_pipeline",
  "description": "RD Economic & Financial Intelligence Platform: five independent Medallion chains run in parallel. BCRD FX (FX-001..009), BCRD CPI (INF-001..006, then COL-001..003), MICM fuel prices (FUEL-001..012), Pro Consumidor basic-goods prices (CON-001..005) and MEM electricity (ENE-001..009). MEM, MICM and Pro Consumidor files are downloaded automatically before Bronze; all Bronze tasks ingest incrementally with Auto Loader. Notebooks run from the Git folder (branch main).",
  "tags": {
    "project": "rd-economic-intelligence",
    "source": "bcrd-micm-proconsumidor-mem",
    "domains": "fx-inflation-fuel-consumer-electricity",
    "environment": "development"
  },
  "performance_target": "STANDARD",
  "max_concurrent_runs": 1,
  "timeout_seconds": 3600,
  "email_notifications": {
    "on_failure": [
      "sffernandez06@gmail.com"
    ],
    "no_alert_for_skipped_runs": true
  },
  "schedule": {
    "quartz_cron_expression": "0 0 7 ? * MON-FRI",
    "timezone_id": "America/Santo_Domingo",
    "pause_status": "PAUSED"
  },
  "tasks": [
    {
      "task_key": "download_proconsumidor_prices",
      "description": "Download the current Pro Consumidor basic-goods price report from datos.gob.do into the append-only proconsumidor_raw archive (skips content already archived)",
      "notebook_task": {
        "notebook_path": "/Users/sffernandez06@gmail.com/rd-economic-financial-intelligence/src/bronze/05_ProConsumidor_Prices_Download",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 120000,
      "timeout_seconds": 900
    },
    {
      "task_key": "download_micm_fuel_prices",
      "description": "Download the current MICM fuel-price XLSX and CSV from datos.gob.do into the append-only micm_raw archive (skips content already archived)",
