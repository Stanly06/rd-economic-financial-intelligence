// =====================================================================
// RD Economic & Financial Intelligence Platform — Power BI measures
// Tables (Import mode, from Databricks SQL):
//   'FX Daily'    = rd_economic_intelligence.gold.exchange_rate_metrics
//   'FX Monthly'  = rd_economic_intelligence.gold.exchange_rate_monthly_metrics
//   'Inflation'   = rd_economic_intelligence.gold.inflation_metrics
//   'Cost of Living' = rd_economic_intelligence.gold.cost_of_living_metrics
//   'Calendar'    = DAX calculated table (below)
// Convention (KPI decision D1): FX rate up = peso depreciation.
// =====================================================================


// ---------- Calendar (Modeling > New table) ----------
Calendar =
ADDCOLUMNS (
    CALENDAR ( DATE ( 1984, 1, 1 ), DATE ( 2026, 12, 31 ) ),
    "Year", YEAR ( [Date] ),
    "Month Number", MONTH ( [Date] ),
    "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
    "Month", FORMAT ( [Date], "MMM yyyy" ),
    "Weekday", WEEKDAY ( [Date], 2 )
)
// Mark as date table on [Date]. Sort "Month" by "Month Start".
// Relationships (single direction, Calendar -> fact):
//   Calendar[Date] 1 -> * 'FX Daily'[rate_date]
//   Calendar[Date] 1 -> * 'FX Monthly'[month_start]
//   Calendar[Date] 1 -> * 'Inflation'[reference_month]
//   Calendar[Date] 1 -> * 'Cost of Living'[reference_month]


// =====================================================================
// FX — daily (FX-001, 002, 003, 006, 007, 008, 009)
// Values are taken on the latest date in the current filter context.
// =====================================================================
FX Latest Date =
CALCULATE ( MAX ( 'FX Daily'[rate_date] ) )

FX Buy Rate =
VAR d = [FX Latest Date]
RETURN CALCULATE ( MAX ( 'FX Daily'[rate] ), 'FX Daily'[rate_type] = "buy", 'FX Daily'[rate_date] = d )

FX Sell Rate =
VAR d = [FX Latest Date]
RETURN CALCULATE ( MAX ( 'FX Daily'[rate] ), 'FX Daily'[rate_type] = "sell", 'FX Daily'[rate_date] = d )

FX Spread =
[FX Sell Rate] - [FX Buy Rate]

FX Daily Change % =
VAR d = [FX Latest Date]
RETURN DIVIDE ( CALCULATE ( MAX ( 'FX Daily'[daily_change_pct] ), 'FX Daily'[rate_type] = "sell", 'FX Daily'[rate_date] = d ), 100 )

FX YTD Change % =
VAR d = [FX Latest Date]
RETURN DIVIDE ( CALCULATE ( MAX ( 'FX Daily'[ytd_change_pct] ), 'FX Daily'[rate_type] = "sell", 'FX Daily'[rate_date] = d ), 100 )

FX MA30 =
VAR d = [FX Latest Date]
RETURN CALCULATE ( MAX ( 'FX Daily'[ma30_rate] ), 'FX Daily'[rate_type] = "sell", 'FX Daily'[rate_date] = d )

FX 52W High =
VAR d = [FX Latest Date]
RETURN CALCULATE ( MAX ( 'FX Daily'[high_52w_rate] ), 'FX Daily'[rate_type] = "sell", 'FX Daily'[rate_date] = d )

FX 52W Low =
VAR d = [FX Latest Date]
RETURN CALCULATE ( MAX ( 'FX Daily'[low_52w_rate] ), 'FX Daily'[rate_type] = "sell", 'FX Daily'[rate_date] = d )

// For line charts over time (respects the rate_type slicer)
FX Rate =
AVERAGE ( 'FX Daily'[rate] )

FX Rate MA30 =
AVERAGE ( 'FX Daily'[ma30_rate] )

FX Peso Direction =
IF ( [FX YTD Change %] > 0, "Peso depreciating in the year", "Peso appreciating in the year" )


// =====================================================================
// FX — monthly (FX-004, FX-005)
// =====================================================================
FX MoM % =
DIVIDE ( AVERAGE ( 'FX Monthly'[mom_change_pct] ), 100 )

FX YoY % =
DIVIDE ( AVERAGE ( 'FX Monthly'[yoy_change_pct] ), 100 )

FX Month Is Partial =
IF ( MAXX ( 'FX Monthly', INT ( 'FX Monthly'[is_partial_month] ) ) = 1, "Month to date", "Full month" )


// =====================================================================
// Inflation (INF-001 to INF-006)
// =====================================================================
CPI Latest Month =
CALCULATE ( MAX ( 'Inflation'[reference_month] ), REMOVEFILTERS ( 'Inflation'[series_name], 'Inflation'[series_type] ), 'Inflation'[series_type] = "headline" )

Headline Inflation YoY % =
VAR m = [CPI Latest Month]
RETURN DIVIDE ( CALCULATE ( MAX ( 'Inflation'[yoy_inflation_pct] ), REMOVEFILTERS ( 'Inflation'[series_name] ), 'Inflation'[series_type] = "headline", 'Inflation'[reference_month] = m ), 100 )

Headline Inflation YTD % =
VAR m = [CPI Latest Month]
RETURN DIVIDE ( CALCULATE ( MAX ( 'Inflation'[ytd_inflation_pct] ), REMOVEFILTERS ( 'Inflation'[series_name] ), 'Inflation'[series_type] = "headline", 'Inflation'[reference_month] = m ), 100 )

Headline Inflation MoM % =
VAR m = [CPI Latest Month]
RETURN DIVIDE ( CALCULATE ( MAX ( 'Inflation'[mom_inflation_pct] ), REMOVEFILTERS ( 'Inflation'[series_name] ), 'Inflation'[series_type] = "headline", 'Inflation'[reference_month] = m ), 100 )

Core Inflation YoY % =
VAR m = [CPI Latest Month]
RETURN DIVIDE ( CALCULATE ( MAX ( 'Inflation'[yoy_inflation_pct] ), REMOVEFILTERS ( 'Inflation'[series_name] ), 'Inflation'[series_type] = "core", 'Inflation'[reference_month] = m ), 100 )

// For charts over time and by group/region (respects series slicers)
Inflation YoY % =
DIVIDE ( AVERAGE ( 'Inflation'[yoy_inflation_pct] ), 100 )

Inflation MoM % =
DIVIDE ( AVERAGE ( 'Inflation'[mom_inflation_pct] ), 100 )

CPI Index =
AVERAGE ( 'Inflation'[index_value] )


// =====================================================================
// FX vs inflation (BRD: "How do exchange-rate movements compare with inflation?")
// Use on a monthly axis: Calendar[Month]
// =====================================================================
Headline YoY % (monthly axis) =
DIVIDE ( CALCULATE ( AVERAGE ( 'Inflation'[yoy_inflation_pct] ), REMOVEFILTERS ( 'Inflation'[series_name] ), 'Inflation'[series_type] = "headline" ), 100 )

FX Sell YoY % (monthly axis) =
DIVIDE ( CALCULATE ( AVERAGE ( 'FX Monthly'[yoy_change_pct] ), 'FX Monthly'[rate_type] = "sell" ), 100 )


// =====================================================================
// Cost of living (COL-001 to COL-003)
// =====================================================================
COL Latest Month =
CALCULATE ( MAX ( 'Cost of Living'[reference_month] ), REMOVEFILTERS ( 'Cost of Living'[segment], 'Cost of Living'[segment_type] ) )

Basket Cost =
AVERAGE ( 'Cost of Living'[basket_cost_dop] )

Basket Cost National =
VAR m = [COL Latest Month]
RETURN CALCULATE ( MAX ( 'Cost of Living'[basket_cost_dop] ), REMOVEFILTERS ( 'Cost of Living'[segment] ), 'Cost of Living'[segment_type] = "national", 'Cost of Living'[reference_month] = m )

Basket Cost YoY % =
VAR m = [COL Latest Month]
RETURN DIVIDE ( CALCULATE ( MAX ( 'Cost of Living'[yoy_change_pct] ), REMOVEFILTERS ( 'Cost of Living'[segment] ), 'Cost of Living'[segment_type] = "national", 'Cost of Living'[reference_month] = m ), 100 )

Q5 vs Q1 Gap DOP =
VAR m = [COL Latest Month]
RETURN CALCULATE ( MAX ( 'Cost of Living'[q5_q1_gap_dop] ), REMOVEFILTERS ( 'Cost of Living'[segment] ), 'Cost of Living'[segment_type] = "national", 'Cost of Living'[reference_month] = m )

Q5 vs Q1 Ratio =
VAR m = [COL Latest Month]
RETURN CALCULATE ( MAX ( 'Cost of Living'[q5_q1_ratio] ), REMOVEFILTERS ( 'Cost of Living'[segment] ), 'Cost of Living'[segment_type] = "national", 'Cost of Living'[reference_month] = m )


// =====================================================================
// Measures used by the report pages (added while building the .pbix)
// "Latest" measures ignore series/segment filters when finding the latest
// month, so they work with series_name / segment on a chart axis.
// =====================================================================
FX Sell MoM % =
DIVIDE ( CALCULATE ( AVERAGE ( 'FX Monthly'[mom_change_pct] ), 'FX Monthly'[rate_type] = "sell" ), 100 )

Core YoY % (monthly axis) =
DIVIDE ( CALCULATE ( AVERAGE ( 'Inflation'[yoy_inflation_pct] ), REMOVEFILTERS ( 'Inflation'[series_name] ), 'Inflation'[series_type] = "core" ), 100 )

Group YoY % (latest) =
VAR m = [CPI Latest Month]
RETURN DIVIDE ( CALCULATE ( MAX ( 'Inflation'[yoy_inflation_pct] ), 'Inflation'[series_type] = "expenditure_group", 'Inflation'[reference_month] = m ), 100 )

Region YoY % (latest) =
VAR m = [CPI Latest Month]
RETURN DIVIDE ( CALCULATE ( MAX ( 'Inflation'[yoy_inflation_pct] ), 'Inflation'[series_type] = "region", 'Inflation'[reference_month] = m ), 100 )

Headline YoY % (FX period) =
IF ( NOT ISBLANK ( [FX Sell YoY % (monthly axis)] ), [Headline YoY % (monthly axis)] )

Quintile Basket Cost (latest) =
VAR m = [COL Latest Month]
RETURN CALCULATE ( MAX ( 'Cost of Living'[basket_cost_dop] ), 'Cost of Living'[segment_type] IN { "income_quintile", "national" }, 'Cost of Living'[reference_month] = m )

Region Basket Cost (latest) =
VAR m = [COL Latest Month]
RETURN CALCULATE ( MAX ( 'Cost of Living'[basket_cost_dop] ), 'Cost of Living'[segment_type] = "region", 'Cost of Living'[reference_month] = m )

National Basket Cost (monthly axis) =
CALCULATE ( AVERAGE ( 'Cost of Living'[basket_cost_dop] ), REMOVEFILTERS ( 'Cost of Living'[segment] ), 'Cost of Living'[segment_type] = "national" )

Q1 Basket Cost (monthly axis) =
CALCULATE ( AVERAGE ( 'Cost of Living'[basket_cost_dop] ), REMOVEFILTERS ( 'Cost of Living'[segment_type] ), 'Cost of Living'[segment] = "Quintil 1" )

Q5 Basket Cost (monthly axis) =
CALCULATE ( AVERAGE ( 'Cost of Living'[basket_cost_dop] ), REMOVEFILTERS ( 'Cost of Living'[segment_type] ), 'Cost of Living'[segment] = "Quintil 5" )

// ---------------------------------------------------------------------
// Fuel Prices  = rd_economic_intelligence.gold.fuel_price_metrics (FUEL-001..012)
// Consumer Prices = rd_economic_intelligence.gold.consumer_price_metrics (CON-001..005)
// Fuel measures cover the five retail fuels: gasolina premium/regular, gasoil optimo/regular, GLP.
// No relationship to Calendar: both pages use their own date columns.
// ---------------------------------------------------------------------

Fuel Latest Week =
CALCULATE ( MAX ( 'Fuel Prices'[period_start_date] ), REMOVEFILTERS ( 'Fuel Prices'[fuel_name], 'Fuel Prices'[fuel_code] ) )

Fuel Latest Week Label =
VAR d = [Fuel Latest Week]
VAR e = CALCULATE ( MAX ( 'Fuel Prices'[period_end_date] ), REMOVEFILTERS ( 'Fuel Prices'[fuel_name], 'Fuel Prices'[fuel_code] ), 'Fuel Prices'[period_start_date] = d )
RETURN "Semana " & FORMAT ( d, "dd/mm/yyyy" ) & " – " & FORMAT ( e, "dd/mm/yyyy" ) & " · RD$ por galón · Fuente: MICM"

Fuel Price =
VAR d = [Fuel Latest Week]
RETURN CALCULATE ( AVERAGE ( 'Fuel Prices'[price_dop] ), 'Fuel Prices'[period_start_date] = d, KEEPFILTERS ( 'Fuel Prices'[fuel_code] IN { "gasolina_premium", "gasolina_regular", "gasoil_optimo", "gasoil_regular", "glp" } ) )

Fuel Weekly Change % =
VAR d = [Fuel Latest Week]
RETURN DIVIDE ( CALCULATE ( AVERAGE ( 'Fuel Prices'[weekly_change_pct] ), 'Fuel Prices'[period_start_date] = d, KEEPFILTERS ( 'Fuel Prices'[fuel_code] IN { "gasolina_premium", "gasolina_regular", "gasoil_optimo", "gasoil_regular", "glp" } ) ), 100 )

Fuel Monthly Change % =
VAR d = [Fuel Latest Week]
RETURN DIVIDE ( CALCULATE ( AVERAGE ( 'Fuel Prices'[monthly_change_pct] ), 'Fuel Prices'[period_start_date] = d, KEEPFILTERS ( 'Fuel Prices'[fuel_code] IN { "gasolina_premium", "gasolina_regular", "gasoil_optimo", "gasoil_regular", "glp" } ) ), 100 )

Fuel YoY % =
VAR d = [Fuel Latest Week]
RETURN DIVIDE ( CALCULATE ( AVERAGE ( 'Fuel Prices'[yoy_change_pct] ), 'Fuel Prices'[period_start_date] = d, KEEPFILTERS ( 'Fuel Prices'[fuel_code] IN { "gasolina_premium", "gasolina_regular", "gasoil_optimo", "gasoil_regular", "glp" } ) ), 100 )

Fuel YTD % =
VAR d = [Fuel Latest Week]
RETURN DIVIDE ( CALCULATE ( AVERAGE ( 'Fuel Prices'[ytd_change_pct] ), 'Fuel Prices'[period_start_date] = d, KEEPFILTERS ( 'Fuel Prices'[fuel_code] IN { "gasolina_premium", "gasolina_regular", "gasoil_optimo", "gasoil_regular", "glp" } ) ), 100 )

Fuel 52W High =
VAR d = [Fuel Latest Week]
RETURN CALCULATE ( AVERAGE ( 'Fuel Prices'[high_52w_dop] ), 'Fuel Prices'[period_start_date] = d, KEEPFILTERS ( 'Fuel Prices'[fuel_code] IN { "gasolina_premium", "gasolina_regular", "gasoil_optimo", "gasoil_regular", "glp" } ) )

Fuel 52W Low =
VAR d = [Fuel Latest Week]
RETURN CALCULATE ( AVERAGE ( 'Fuel Prices'[low_52w_dop] ), 'Fuel Prices'[period_start_date] = d, KEEPFILTERS ( 'Fuel Prices'[fuel_code] IN { "gasolina_premium", "gasolina_regular", "gasoil_optimo", "gasoil_regular", "glp" } ) )

Fuel Volatility 12W =
VAR d = [Fuel Latest Week]
RETURN DIVIDE ( CALCULATE ( AVERAGE ( 'Fuel Prices'[volatility_12w_pct] ), 'Fuel Prices'[period_start_date] = d, KEEPFILTERS ( 'Fuel Prices'[fuel_code] IN { "gasolina_premium", "gasolina_regular", "gasoil_optimo", "gasoil_regular", "glp" } ) ), 100 )

Fuel Price Series =
CALCULATE ( AVERAGE ( 'Fuel Prices'[price_dop] ), KEEPFILTERS ( 'Fuel Prices'[fuel_code] IN { "gasolina_premium", "gasolina_regular", "gasoil_optimo", "gasoil_regular", "glp" } ) )

Premium Price =
CALCULATE ( [Fuel Price], 'Fuel Prices'[fuel_code] = "gasolina_premium" )

Regular Price =
CALCULATE ( [Fuel Price], 'Fuel Prices'[fuel_code] = "gasolina_regular" )

Gasoil Regular Price =
CALCULATE ( [Fuel Price], 'Fuel Prices'[fuel_code] = "gasoil_regular" )

GLP Price =
CALCULATE ( [Fuel Price], 'Fuel Prices'[fuel_code] = "glp" )

CON Latest Month =
CALCULATE ( MAX ( 'Consumer Prices'[reference_month] ), REMOVEFILTERS ( 'Consumer Prices'[product], 'Consumer Prices'[presentation] ) )

CON Period Label =
"Mes de referencia: " & FORMAT ( [CON Latest Month], "mmmm yyyy" ) & " · Precios en RD$ · Fuente: Pro Consumidor (julio–septiembre 2026)"

CON Avg Price =
VAR m = [CON Latest Month]
RETURN CALCULATE ( AVERAGE ( 'Consumer Prices'[avg_price_dop] ), 'Consumer Prices'[reference_month] = m )

CON Median Price =
VAR m = [CON Latest Month]
RETURN CALCULATE ( AVERAGE ( 'Consumer Prices'[median_price_dop] ), 'Consumer Prices'[reference_month] = m )

CON Min Price =
VAR m = [CON Latest Month]
RETURN CALCULATE ( MIN ( 'Consumer Prices'[min_price_dop] ), 'Consumer Prices'[reference_month] = m )

CON Max Price =
VAR m = [CON Latest Month]
RETURN CALCULATE ( MAX ( 'Consumer Prices'[max_price_dop] ), 'Consumer Prices'[reference_month] = m )

CON MoM % =
VAR m = [CON Latest Month]
RETURN DIVIDE ( CALCULATE ( AVERAGE ( 'Consumer Prices'[mom_change_pct] ), 'Consumer Prices'[reference_month] = m ), 100 )

CON Spread % =
VAR m = [CON Latest Month]
RETURN DIVIDE ( CALCULATE ( AVERAGE ( 'Consumer Prices'[price_spread_pct] ), 'Consumer Prices'[reference_month] = m ), 100 )

CON Cheapest Segment =
VAR m = [CON Latest Month]
RETURN CALCULATE ( MAX ( 'Consumer Prices'[cheapest_segment] ), 'Consumer Prices'[reference_month] = m )

CON Most Expensive Segment =
VAR m = [CON Latest Month]
RETURN CALCULATE ( MAX ( 'Consumer Prices'[most_expensive_segment] ), 'Consumer Prices'[reference_month] = m )

CON Products Tracked =
VAR m = [CON Latest Month]
RETURN CALCULATE ( DISTINCTCOUNT ( 'Consumer Prices'[product] ), 'Consumer Prices'[reference_month] = m )

CON Products Up =
VAR m = [CON Latest Month]
RETURN CALCULATE ( COUNTROWS ( 'Consumer Prices' ), 'Consumer Prices'[reference_month] = m, 'Consumer Prices'[mom_change_pct] > 0 )

CON Products Down =
VAR m = [CON Latest Month]
RETURN CALCULATE ( COUNTROWS ( 'Consumer Prices' ), 'Consumer Prices'[reference_month] = m, 'Consumer Prices'[mom_change_pct] < 0 )

CON MoM % Top 15 =
VAR r = RANKX ( ALLSELECTED ( 'Consumer Prices'[product] ), [CON MoM %], , DESC )
RETURN IF ( NOT ISBLANK ( [CON MoM %] ) && r <= 15, [CON MoM %] )

// ---------------------------------------------------------------------
// Electricity      = rd_economic_intelligence.gold.electricity_metrics (ENE-005..009)
// Electricity Bill = rd_economic_intelligence.gold.electricity_bts1_bill (ENE-003..004)
// Cards show the latest month for Total EDE; the bill uses Edesur, 200 kWh.
// ---------------------------------------------------------------------

ELEC Latest Month =
CALCULATE ( MAX ( 'Electricity'[reference_month] ), REMOVEFILTERS ( 'Electricity'[distributor] ) )

ELEC Selling Price =
VAR m = [ELEC Latest Month]
RETURN CALCULATE ( AVERAGE ( 'Electricity'[selling_price_dop_kwh] ), 'Electricity'[reference_month] = m, KEEPFILTERS ( 'Electricity'[distributor] = "Total EDE" ) )

ELEC Selling Price YoY % =
VAR m = [ELEC Latest Month]
RETURN DIVIDE ( CALCULATE ( AVERAGE ( 'Electricity'[selling_price_yoy_pct] ), 'Electricity'[reference_month] = m, KEEPFILTERS ( 'Electricity'[distributor] = "Total EDE" ) ), 100 )

ELEC Purchase Price cUSD =
VAR m = [ELEC Latest Month]
RETURN CALCULATE ( AVERAGE ( 'Electricity'[purchase_price_cusd_kwh] ), 'Electricity'[reference_month] = m, KEEPFILTERS ( 'Electricity'[distributor] = "Total EDE" ) )

ELEC Losses Rolling % =
VAR m = [ELEC Latest Month]
RETURN DIVIDE ( CALCULATE ( AVERAGE ( 'Electricity'[losses_rolling_pct] ), 'Electricity'[reference_month] = m, KEEPFILTERS ( 'Electricity'[distributor] = "Total EDE" ) ), 100 )

ELEC CRI Rolling % =
VAR m = [ELEC Latest Month]
RETURN DIVIDE ( CALCULATE ( AVERAGE ( 'Electricity'[cri_rolling_pct] ), 'Electricity'[reference_month] = m, KEEPFILTERS ( 'Electricity'[distributor] = "Total EDE" ) ), 100 )

ELEC Selling Price Series =
AVERAGE ( 'Electricity'[selling_price_dop_kwh] )

ELEC Losses Rolling Series =
DIVIDE ( AVERAGE ( 'Electricity'[losses_rolling_pct] ), 100 )

BTS1 Bill 200 kWh Applied =
VAR m = CALCULATE ( MAX ( 'Electricity'[reference_month] ), REMOVEFILTERS ( 'Electricity' ) )
VAR v = CALCULATE ( AVERAGE ( 'Electricity Bill'[applied_bill_dop] ), REMOVEFILTERS ( 'Electricity Bill' ), 'Electricity Bill'[reference_month] = m, 'Electricity Bill'[monthly_kwh] = 200, 'Electricity Bill'[distributor] = "Edesur" )
RETURN "RD$" & FORMAT ( v, "#,0" )

BTS1 Bill 200 kWh Reference =
VAR m = CALCULATE ( MAX ( 'Electricity'[reference_month] ), REMOVEFILTERS ( 'Electricity' ) )
VAR v = CALCULATE ( AVERAGE ( 'Electricity Bill'[reference_bill_dop] ), REMOVEFILTERS ( 'Electricity Bill' ), 'Electricity Bill'[reference_month] = m, 'Electricity Bill'[monthly_kwh] = 200, 'Electricity Bill'[distributor] = "Edesur" )
RETURN "RD$" & FORMAT ( v, "#,0" )

Bill 200 kWh Applied (Edesur) =
CALCULATE ( AVERAGE ( 'Electricity Bill'[applied_bill_dop] ), 'Electricity Bill'[distributor] = "Edesur", 'Electricity Bill'[monthly_kwh] = 200 )

Bill 200 kWh Reference (Edesur) =
CALCULATE ( AVERAGE ( 'Electricity Bill'[reference_bill_dop] ), 'Electricity Bill'[distributor] = "Edesur", 'Electricity Bill'[monthly_kwh] = 200 )
